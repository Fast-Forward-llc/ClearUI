<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<Target Name="NpmInstall" Inputs="package.json" Outputs="node_modules/.install-stamp">
		<!--
        Use npm install or npm ci depending on RestorePackagesWithLockFile value.
        Uncomment the following lines if you want to use this feature:
		-->
        <PropertyGroup>
          <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        </PropertyGroup>
     
		<Exec Command="npm ci" Condition="'$(RestorePackagesWithLockFile)' == 'true'" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="npm install" Condition="'$(RestorePackagesWithLockFile)' != 'true'" WorkingDirectory="$(MSBuildProjectDirectory)" />

		<!-- Write the stamp file, so incremental builds work -->
		<Touch Files="node_modules/.install-stamp" AlwaysCreate="true" />
	</Target>
	<Target Name="BuildJs" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild">
		<Message Text="Running JavaScript build: npm install and npm run build" Importance="high" />
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>
	<Target Name="CreateNpmPackage" AfterTargets="Publish">
		<ItemGroup>
			<DistFiles Include="$(MSBuildProjectDirectory)\dist\**\*" />
		</ItemGroup>
		<Message Text="Running JavaScript build: npm install and npm run build" Importance="high" />
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Copy Vue components -->
		<Copy SourceFiles="@(DistFiles)" DestinationFiles="@(DistFiles->'$(PublishDir)dist\%(RecursiveDir)%(Filename)%(Extension)')" />
		<WriteLinesToFile File="$(PublishDir)package.json" Lines="{&#xD;&#xA;  &quot;name&quot;: &quot;clearui&quot;,&#xD;&#xA;  &quot;version&quot;: &quot;1.0.0&quot;,&#xD;&#xA;  &quot;main&quot;: &quot;dist/clear-ui.es.js&quot;,&#xD;&#xA;  &quot;files&quot;: [&#xD;&#xA;    &quot;dist/&quot;&#xD;&#xA;  ],&#xD;&#xA;  &quot;description&quot;: &quot;ClearUI Vue3 UI library&quot;,&#xD;&#xA;  &quot;author&quot;: &quot;Your Name&quot;,&#xD;&#xA;  &quot;license&quot;: &quot;MIT&quot;&#xD;&#xA;}" Overwrite="true" />		
	</Target>

	<ItemGroup>
		<VueComponents Include="VueComponents\*.vue" />
		<JsFiles Include="js\*.js" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ClearUIDemoApp\Pages\" />
	</ItemGroup>
</Project>
